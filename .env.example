# --- Public address of the site, used at BUILD time (canonical links, sitemap, structured data).
# Docker: set SITE_URL in the .env next to docker-compose.yml, it is passed as a build argument.
SITE_URL=https://your-domain.example

# --- Database (Postgres). REQUIRED on Vercel / any serverless host; strongly recommended everywhere.
# Supabase or Neon free tier work: copy the connection string (use the pooled/"transaction" one on serverless).
# Without it a local embedded database in ./data/pglite is used (fine for development, temporary on servers).
DATABASE_URL=

# --- Admin panel (/admin). The first administrator is created on the first successful login with these
# two values, only while there are no users yet. Change the password in "My account" straight away.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=

# --- Lead delivery: e-mail only (/api/lead). All of SMTP_HOST, LEADS_EMAIL_TO and a sender are required.
# Without them the contact forms show an error instead of silently losing the request.
SMTP_HOST=
SMTP_PORT=587           # 465 enables implicit TLS
SMTP_USER=
SMTP_PASS=
LEADS_EMAIL_TO=         # mailbox that receives the requests
LEADS_EMAIL_FROM=       # defaults to SMTP_USER
# Emergency log used only if the database is unreachable (default: ./data/leads.jsonl). Contains personal data.
LEADS_LOG_FILE=
