# --- Admin panel (/admin). Without both values the admin stays disabled.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=   # random string, at least 32 characters
# Where owner-edited prices are stored (default: ./data/prices.json). Mount a volume in Docker.
PRICES_FILE=

# --- Lead delivery: e-mail only (/api/lead). All of SMTP_HOST, LEADS_EMAIL_TO and a sender are required.
# Without them the contact forms show an error instead of silently losing the request.
SMTP_HOST=
SMTP_PORT=587           # 465 enables implicit TLS
SMTP_USER=
SMTP_PASS=
LEADS_EMAIL_TO=         # mailbox that receives the requests
LEADS_EMAIL_FROM=       # defaults to SMTP_USER
# Local backup log of every request (default: ./data/leads.jsonl). Contains personal data, keep it private.
LEADS_LOG_FILE=
