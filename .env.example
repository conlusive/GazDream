# --- Admin panel (/admin). Without both values the admin stays disabled.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=   # random string, at least 32 characters
# Where owner-edited prices are stored (default: ./data/prices.json). Mount a volume in Docker.
PRICES_FILE=

# --- Lead delivery (/api/lead). Configure at least one channel; all configured ones are used,
# and a lead counts as delivered when any of them succeeds.
# Telegram (recommended: instant push). Create a bot with @BotFather, add it to the chat, use its chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail over SMTP (works with any provider, e.g. Gmail with an app password).
SMTP_HOST=
SMTP_PORT=587           # 465 enables implicit TLS
SMTP_USER=
SMTP_PASS=
LEADS_EMAIL_TO=
LEADS_EMAIL_FROM=       # defaults to SMTP_USER
# Generic webhook (CRM, Google Sheets script, Zapier/Make): receives the lead as JSON.
LEAD_WEBHOOK_URL=
# Local backup log of every lead (default: ./data/leads.jsonl). Contains personal data, keep it private.
LEADS_LOG_FILE=
